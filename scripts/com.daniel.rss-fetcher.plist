<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.daniel.rss-fetcher</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/daniel/Documents/rss_feed_fetcher/src/app.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/daniel/Documents/rss_feed_fetcher</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_OPTIONS</key>
    <string>--max-old-space-size=512</string>
    <key>DUCKDB_THREADS</key>
    <string>2</string>
    <key>DUCKDB_MEMORY_LIMIT</key>
    <string>1GB</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>

  <!-- Restart automatically if the process exits for any reason -->
  <key>KeepAlive</key>
  <true/>

  <!-- Minimum seconds between restarts (prevents tight crash loops) -->
  <key>ThrottleInterval</key>
  <integer>300</integer>

  <!-- Keep the machine responsive: background QoS, low CPU/IO priority -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>10</integer>
  <key>LowPriorityIO</key>
  <true/>

  <!-- Start immediately when loaded -->
  <key>RunAtLoad</key>
  <true/>

  <!-- App writes logs/rss_fetch.log itself; launchd captures anything emitted before/after that
       (e.g. startup failures) outside ~/Documents so it is always writable -->
  <key>StandardOutPath</key>
  <string>/Users/daniel/Library/Logs/rss-fetcher.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/daniel/Library/Logs/rss-fetcher.launchd.log</string>
</dict>
</plist>
