<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.daniel.rss-fetcher</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/daniel/Documents/rss_feed_fetcher/src/app.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/daniel/Documents/rss_feed_fetcher</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_OPTIONS</key>
    <string>--max-old-space-size=512</string>
    <key>DUCKDB_THREADS</key>
    <string>2</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>

  <!-- Restart automatically if the process exits for any reason -->
  <key>KeepAlive</key>
  <true/>

  <!-- Minimum seconds between restarts (prevents tight crash loops) -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- Start immediately when loaded -->
  <key>RunAtLoad</key>
  <true/>

  <!-- App writes directly to logs/rss_fetch.log with 5 MB rotation; no launchd capture needed -->
</dict>
</plist>
