{
  "watch": ["src/"],
  "ext": "js,env",
  "ignore": ["src/**/*.test.js", "node_modules/"],
  "delay": "2500",
  "env": {
    "NODE_ENV": "development"
  },
  "events": {
    "crash": "shutdown",
    "restart": "echo 'App restarted due to error'"
  },
  "exec": "node",
  "restartable": "rs",
  "verbose": true,
  "signal": "SIGUSR2",
  "timeout": 600000,
  "onError": {
    "restart": true,
    "delay": 600000
  }
} 